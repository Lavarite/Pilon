+
+// Android can hide a directory listing with ENOENT while permitting known descendants.
+func androidDirectoryOpenError(dirname string, err error) error {
+	if err == syscall.ENOENT {
+		if info, statErr := os.Stat(dirname); statErr == nil && info.IsDir() {
+			return syscall.EACCES
+		}
+	}
+	return err
+}
