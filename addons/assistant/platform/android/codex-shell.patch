+            b"PILON_DNS_V1\n4 127.0.0.1\n4 127.0.0.1\n",
+            b"PILON_DNS_V1\n4 example.com\n",
+            b"PILON_DNS_V1\n4 127.0.0.1\r\n",
+            b"PILON_DNS_V1\n4 \xff\n",
+        ] {
+            assert!(parse_addresses(bytes, 80).is_err(), "accepted {bytes:?}");
+        }
+        assert!(parse_addresses(&vec![b'x'; MAX_OUTPUT + 1], 80).is_err());
+        let many = format!(
+            "PILON_DNS_V1\n{}",
