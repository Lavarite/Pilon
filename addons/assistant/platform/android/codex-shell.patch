+        let executable = std::env::current_exe().unwrap();
+        let helper = helper.clone();
+        let output = tokio::task::spawn_blocking(move || {
+            let mut command = Command::new(executable);
+            command.args([
+                "--exact",
+                "dialer::tests::platform_dns_websocket_subprocess_probe",
+                "--nocapture",
+            ]);
+            for key in [
+                "HTTP_PROXY",
+                "HTTPS_PROXY",
+                "ALL_PROXY",
+                "NO_PROXY",
+                "http_proxy",
+                "https_proxy",
+                "all_proxy",
+                "no_proxy",
+                "SSL_CERT_FILE",
+                "CODEX_CA_CERTIFICATE",
+            ] {
+                command.env_remove(key);
+            }
+            command
+                .env("PILON_DNS_HELPER", helper)
+                .env("PILON_DNS_TEST_URL", url)
+                .env("PILON_DNS_TEST_MODE", mode);
+            if mode != "direct" {
+                command.env("HTTP_PROXY", proxy_url);
+            }
+            if mode.contains("bypass") {
+                command.env("NO_PROXY", "pilon-dns.invalid");
+            }
+            command.output().unwrap()
+        })
+        .await
+        .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        task.await.unwrap();
+        if let Some(task) = proxy_task {
+            task.await.unwrap();
+        }
+    }
+    std::fs::remove_file(helper).unwrap();
+}
+
+#[tokio::test]
+async fn platform_dns_websocket_subprocess_probe() {
+    let Ok(url) = std::env::var("PILON_DNS_TEST_URL") else {
+        return;
+    };
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let request = url.into_client_request().unwrap();
+    let mut websocket = if std::env::var("PILON_DNS_TEST_MODE").unwrap() == "explicit-bypass" {
+        let (inner, _) = connect(
+            request,
+            WebSocketConfig::default(),
+            Some(test_tls_configs().0),
+            OutboundProxyRoute::Proxy {
+                url: "http://unreachable.invalid:9".to_owned(),
+                no_proxy: Some("pilon-dns.invalid".to_owned()),
+            },
+            TcpNodelay::Default,
+            false,
+        )
+        .await
+        .unwrap();
+        test_connection(inner)
+    } else {
+        WebSocketConnector::new(&factory)
+            .unwrap()
+            .connect(request, WebSocketConfig::default())
+            .await
+            .unwrap()
+            .0
+    };
+    let expected = Message::Text("platform DNS".into());
+    websocket.send(expected.clone()).await.unwrap();
+    assert_eq!(websocket.next().await.unwrap().unwrap(), expected);
+}
