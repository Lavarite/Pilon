+//! Android's packaged musl executable delegates DNS to the public Bionic resolver.
+use std::collections::HashSet;
+use std::io;
+use std::net::{IpAddr, SocketAddr, SocketAddrV6};
+use std::path::{Path, PathBuf};
+use std::process::Stdio;
+use std::sync::Arc;
+use std::time::Duration;
+
+use reqwest::dns::{Addrs, Name, Resolve, Resolving};
+use tokio::io::AsyncReadExt;
+
+const HELPER_ENV: &str = "PILON_DNS_HELPER";
+const MAX_OUTPUT: usize = 8192;
+const MAX_ADDRESSES: usize = 64;
+const TIMEOUT: Duration = Duration::from_secs(15);
+
+pub fn configured() -> bool {
+    helper_path().is_some()
+}
+
+fn helper_path() -> Option<PathBuf> {
+    std::env::var_os(HELPER_ENV)
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+}
+
+pub fn configure(builder: reqwest::ClientBuilder) -> reqwest::ClientBuilder {
+    match helper_path() {
+        Some(helper) => builder.dns_resolver(Arc::new(PlatformResolver { helper })),
+        None => builder,
+    }
+}
+
+// Both HTTP and WebSocket lookups must use Android's per-network resolver.
+pub async fn lookup_host(address: String) -> io::Result<Vec<SocketAddr>> {
+    match helper_path() {
+        Some(helper) => lookup_with_helper(&helper, &address).await,
+        None => tokio::net::lookup_host(address)
+            .await
+            .map(Iterator::collect),
+    }
+}
+
+async fn lookup_with_helper(helper: &Path, address: &str) -> io::Result<Vec<SocketAddr>> {
+    if let Ok(address) = address.parse::<SocketAddr>() {
+        return Ok(vec![address]);
+    }
+    let (host, port) = address.rsplit_once(':').ok_or_else(invalid_response)?;
+    let port = port.parse::<u16>().map_err(|_| invalid_response())?;
+    resolve(helper, host, port, TIMEOUT).await
+}
+
+struct PlatformResolver {
+    helper: PathBuf,
+}
+
+impl Resolve for PlatformResolver {
+    fn resolve(&self, name: Name) -> Resolving {
+        let helper = self.helper.clone();
+        let host = name.as_str().to_owned();
+        Box::pin(async move {
+            resolve(&helper, &host, 0, TIMEOUT)
+                .await
+                .map(|addresses| Box::new(addresses.into_iter()) as Addrs)
+                .map_err(|error| Box::new(error) as Box<dyn std::error::Error + Send + Sync>)
+        })
+    }
+}
+
+async fn resolve(
+    helper: &Path,
+    host: &str,
+    port: u16,
+    timeout: Duration,
+) -> io::Result<Vec<SocketAddr>> {
+    if let Ok(address) = host.parse::<IpAddr>() {
+        return Ok(vec![SocketAddr::new(address, port)]);
+    }
+    if !helper.is_absolute()
+        || host.is_empty()
+        || host.len() > 253
+        || !host
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'.' | b'_' | b'-'))
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "Invalid Android DNS lookup",
+        ));
+    }
+    let mut child = tokio::process::Command::new(helper)
+        .arg(host)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()?;
+    let result = tokio::time::timeout(timeout, async {
+        let mut bytes = Vec::new();
+        child
+            .stdout
+            .take()
+            .ok_or_else(invalid_response)?
+            .take((MAX_OUTPUT + 1) as u64)
+            .read_to_end(&mut bytes)
+            .await?;
+        if bytes.len() > MAX_OUTPUT {
+            return Err(invalid_response());
+        }
+        if !child.wait().await?.success() {
+            return Err(io::Error::other("Android hostname resolution failed"));
+        }
+        parse_addresses(&bytes, port)
+    })
+    .await;
+    match result {
+        Ok(result) => result,
+        Err(_) => Err(io::Error::new(
+            io::ErrorKind::TimedOut,
+            "Android hostname resolution timed out",
+        )),
+    }
+}
+
+fn invalid_response() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "Invalid Android DNS response")
+}
+
+fn parse_addresses(bytes: &[u8], port: u16) -> io::Result<Vec<SocketAddr>> {
+    if bytes.len() > MAX_OUTPUT || !bytes.ends_with(b"\n") {
+        return Err(invalid_response());
+    }
+    let text = std::str::from_utf8(bytes).map_err(|_| invalid_response())?;
+    let mut lines = text.split_terminator('\n');
+    if lines.next() != Some("PILON_DNS_V1") {
+        return Err(invalid_response());
+    }
+    let mut addresses = Vec::new();
+    let mut seen = HashSet::new();
+    for line in lines {
+        let parts = line.split(' ').collect::<Vec<_>>();
+        let address = match parts.as_slice() {
+            ["4", ip] => SocketAddr::new(
+                IpAddr::V4(ip.parse().map_err(|_| invalid_response())?),
+                port,
+            ),
+            ["6", ip, scope] => {
+                let scope_id = scope.parse::<u32>().map_err(|_| invalid_response())?;
+                if scope_id.to_string() != *scope {
+                    return Err(invalid_response());
+                }
+                SocketAddr::V6(SocketAddrV6::new(
+                    ip.parse().map_err(|_| invalid_response())?,
+                    port,
+                    0,
+                    scope_id,
+                ))
+            }
+            _ => return Err(invalid_response()),
+        };
+        if addresses.len() == MAX_ADDRESSES || !seen.insert(address) {
+            return Err(invalid_response());
+        }
+        addresses.push(address);
+    }
+    if addresses.is_empty() {
+        return Err(invalid_response());
+    }
+    Ok(addresses)
+}
