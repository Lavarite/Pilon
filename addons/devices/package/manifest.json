{
  "id": "devices",
  "name": "Tailscale",
  "description": "Discover Tailscale peers for SSH.",
  "version": "1.1.0",
  "apiVersion": 1,
  "runtime": "Runtime.qml",
  "startOnEnable": true,
  "dependencies": [{"id": "ssh", "minVersion": "1.1.0"}],
  "lifecycle": "Lifecycle.qml",
  "integrations": [{
    "id": "ssh-devices",
    "name": "Discover peers for SSH",
    "target": "ssh",
    "minVersion": "1.1.0",
    "point": "discovered-devices",
    "apiVersion": 1,
    "entry": "SshDevices.qml",
    "enabledByDefault": true
  }],
  "settings": [
    {
      "id": "devices",
      "name": "Tailscale",
      "entry": "Settings.qml"
    }
  ]
}
