# Public OAuth client IDs initialize the CMake cache when configuring a build.
PILON_GOOGLE_CLIENT_ID=
PILON_MICROSOFT_CLIENT_ID=
PILON_MICROSOFT_ANDROID_CLIENT_ID=

# Optional Google Desktop OAuth value: runtime environment only.
PILON_GOOGLE_CLIENT_SECRET=

# Hosted Calendar server only: a separate randomly generated publisher key.
PILON_PUBLISHER_KEY=

# Optional build/package configuration file outside this repository.
PILON_RELEASE_ENV=
# Empty uses the existing Debug default. Release requires private signing setup.
PILON_ANDROID_BUILD_TYPE=
# Private signing file variables: PILON_ANDROID_KEYSTORE, PILON_ANDROID_KEY_ALIAS,
# PILON_ANDROID_KEYSTORE_PASSWORD, PILON_ANDROID_KEY_PASSWORD.

# Optional locations for development output, the Linux installation and runtimes.
PILON_DEV_DIR=
PILON_INSTALL_ROOT=
PILON_RUNTIME_DIR=
