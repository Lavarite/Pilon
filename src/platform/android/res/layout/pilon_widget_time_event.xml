<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_grid_position" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipChildren="true" android:clipToPadding="true">
    <FrameLayout android:id="@+id/widget_grid_card" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/widget_grid_card_fill" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/pilon_widget_time_fill" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_grid_card_border" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/pilon_widget_time_border" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingLeft="5dp" android:paddingRight="5dp" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/widget_grid_card_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="3" android:ellipsize="end" />
            <TextView android:id="@+id/widget_grid_card_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <TextView android:id="@+id/widget_grid_card_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
