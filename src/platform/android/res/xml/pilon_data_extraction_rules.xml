        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml.bak" />
        <exclude domain="sharedpref" path="com.microsoft.aad.adal.cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.aad.adal.cache.xml.bak" />
